{
  "$schema": "https://opencode.ai/config.json",

  // Helm's preferred local model.
  "model": "mlx/mlx-community/Qwen3.6-35B-A3B-OptiQ-4bit",

  // Never publish sessions or repository context.
  "share": "disabled",

  "permission": {
    // Do not let agents wander outside the Helm repository.
    "external_directory": "ask",

    // Require approval before changing files.
    "edit": "ask",

    // Allow routine inspection, but protect destructive or remote actions.
    "bash": {
      "*": "ask",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git rev-parse*": "allow",

      "git commit*": "ask",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "rm *": "ask",
      "sudo *": "ask"
    },

    // Interrupt identical repeating tool calls.
    "doom_loop": "ask"
  },

  // Avoid monitoring generated, downloaded, and transient trees.
  "watcher": {
    "ignore": [
      ".git/**",
      "artifacts/**",
      "build/**",
      "dev/logs/**",
      "web/node_modules/**",
      "web/dist/**"
    ]
  }
}
