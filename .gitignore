# ─── Rust / Cargo ─────────────────────────────────────────────────────────────
# Leading slash scopes this to the repo root; prevents accidentally matching
# any other rust/target that may appear elsewhere in the tree.
/core/rust/target/
.cargo-target/
target/

# ─── Xcode / Swift ────────────────────────────────────────────────────────────
# Custom build root used by the CI pipeline and local builds.
build/

# Xcode derived data; kept under build/ so CI runners use a predictable path.
# Also listed standalone in case Xcode ever writes it to the repo root.
DerivedData/

# Workspace index embedded inside .xcodeproj (auto-regenerated by Xcode on open).
*.xcworkspace/

# Per-user Xcode state: open tabs, breakpoints, scheme selections, window layout.
xcuserdata/
*.xcuserstate

# Xcode file-migration leftovers.
*.moved-aside

# Distribution, archive, and debug-symbol artifacts.
*.ipa
*.xcarchive
*.dSYM.zip
*.dSYM

# Generated Swift/ObjC source files produced by the Rust FFI build step.
apps/macos-ui/Generated/*

# ─── macOS ────────────────────────────────────────────────────────────────────
# Finder metadata. No leading slash so this matches at every directory depth.
.DS_Store

# ─── Web (Astro / Node) ───────────────────────────────────────────────────────
web/node_modules/
web/.astro/   # Astro internal cache and TypeScript type-gen output
web/dist/     # Static-site build output; deployed by CI, not stored in git

# ─── Python tooling ───────────────────────────────────────────────────────────
# Used by locale-integrity scripts and other developer tooling.
.ruff_cache/
__pycache__/
*.pyc
venv/
.venv/

# ─── opencode ─────────────────────────────────────────────────────────────────
# Local opencode configuration (per-machine settings, permissions, etc.)
opencode.json
opencode.jsonc

# ─── Environment / local tooling ──────────────────────────────────────────────
# direnv environment overrides — each developer maintains their own.
.envrc

# ─── Project-specific ─────────────────────────────────────────────────────────
# In-repository linked worktrees used to isolate agent tasks.
/.worktrees/

# Sentinel file written by worktree-setup scripts to identify the owning agent.
.WORKTREE_ID

# Local scratch outputs (ad-hoc test binaries, logs, release staging).
/artifacts/
/dev/logs/agent-runs.ndjson

# Root-level temporary notes used during release/debug sessions.
/TMP_*
